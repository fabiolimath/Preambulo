@INPROCEEDINGS{4067638,
  author = {Ezzahdi, M.A. and Al Zahr, S. and Koubaa, M. and Puech, N. and Gagnaire,
	M.},
  title = {{LERP: a Quality of Transmission Dependent Heuristic for Routing
	and Wavelength Assignment in Hybrid WDM Networks}},
  booktitle = {{ICCCN - 15th International Conference on Computer Communications
	and Networks}},
  year = {2006},
  pages = {125-136},
  address = {Arlington, Virginia, USA},
  organization = {IEEE},
  abstract = {Over the last decade, numerous routing and wavelength assignment (RWA)
	algorithms have been developed for WDM optical networks planning.
	Most of these algorithms neglect the feasibility of the obtained
	lightpaths. In this paper, we propose a new algorithm, called LERP
	(Lightpath Establishment with Regenerator Placement), that enables
	to solve the problem of RWA in guaranteeing the feasibility of the
	obtained solution. A lightpath is said admissible if the BER (Bit
	Error Rate) at its destination node remains acceptable (remains under
	a given threshold). In the case of BER non-admissibility, one or
	more electrical regenerators may be placed along the lightpath. The
	LERP algorithm aims at minimizing the number of regenerators necessary
	to guarantee the quality of transmission along the lightpath. The
	originality of the our approach consists in considering simultaneously
	four physical layer impairments, namely, chromatic dispersion, polarization
	mode dispersion, amplified spontaneous emission and non-linear phase
	shift. The efficiency of the LERP algorithm is demonstrated via a
	numerical comparison with one of the alternative solutions proposed
	in the literature. Numerical simulations have been carried out in
	the context of the 18-node NSF network.},
  doi = {10.1109/ICCCN.2006.286257},
  issn = {1095-2055},
  keywords = {error statistics;optical fibre dispersion;optical fibre networks;optical
	fibre polarisation;optical repeaters;telecommunication network planning;telecommunication
	network routing;wavelength division multiplexing;BER;LERP algorithm;amplified
	spontaneous emission;bit error rate;chromatic dispersion;hybrid WDM
	optical network planning;lightpath establishment;nonlinear phase
	shift;polarization mode dispersion;quality-of-transmission dependent
	heuristic;regenerator placement;routing assignment;wavelength assignment;Bit
	error rate;Chromatic dispersion;Optical fiber networks;Physical layer;Polarization
	mode dispersion;Spontaneous emission;WDM networks;Wavelength assignment;Wavelength
	division multiplexing;Wavelength routing},
