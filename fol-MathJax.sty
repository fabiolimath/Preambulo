% Uso: \usepackage{fol-MathJax}, antes do \usepackage{fol-LaTeX}
%
% Só macros de modo matemático, escritas para funcionar também no MathJax:
% o trecho entre "Início do bloco MathJax" e "Fim do bloco MathJax" pode ser
% colado, como está, num bloco \( ... \) oculto da página (com as extensões
% color, cancel e newcommand, que o MathJax carrega sozinho quando preciso).
% Nesse trecho use apenas \newcommand, \renewcommand, \newenvironment e
% \definecolor, com no máximo um argumento opcional (o primeiro), e nada de
% \makeatletter, \DeclareMathOperator, \mathpalette, \raisebox, TikZ etc.
% O que só funciona no LaTeX (figuras TikZ, \Zer, \Zerup e o ajuste fino do
% \pm) fica em fol-LaTeX.sty, e os comandos de texto, no preâmbulo.
%
% No Overleaf, o arquivo na raiz do projeto já basta.
% No Xournal++, que compila numa pasta temporária, o LaTeX precisa achar
% este arquivo pela árvore pessoal (TEXMFHOME). Configuração única, com o
% repositório clonado em ~/Preambulo:
% Depois disso, um git pull no clone atualiza o Xournal++.
% O mesmo vale para o fol-LaTeX.sty, que fica na mesma pasta.
%
%   Linux/macOS: 
% mkdir -p "$(kpsewhich -var-value TEXMFHOME)/tex/latex"
% ln -s ~/Preambulo "$(kpsewhich -var-value TEXMFHOME)/tex/latex/Preambulo"

%   No Windows: 
% No PowerShell, supondo o clone em 
% C:\Users\1534604\Desktop\MEGA\Softwares_sala_de_aula\xournal\Preambulo, 
% e ajustando o -Target se ele estiver em outro lugar:

% New-Item -ItemType Directory -Force "$env:USERPROFILE\texmf\tex\latex"
% New-Item -ItemType Junction -Path "$env:USERPROFILE\texmf\tex\latex\Preambulo" -Target "$env:USERPROFILE\Desktop\MEGA\Softwares_sala_de_aula\xournal\Preambulo"
% initexmf --register-root="$env:USERPROFILE\texmf"
% initexmf --update-fndb

% Para testar, kpsewhich fol-MathJax.sty deve mostrar o caminho do arquivo. Depois, aponte o 
% Xournal++ para o Xournal_FOL_template.tex dessa pasta. O MiKTeX mantém um índice dos 
% arquivos. Um git pull que só altera os .sty não exige nada. Se um pull trouxer um 
% arquivo novo que precise ser encontrado, rode initexmf --update-fndb de novo.


\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{fol-MathJax}[2026/11/19 Macros de Fabio Lima compatíveis com MathJax]

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%          Packages           %%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Só os pacotes de que as macros abaixo precisam. No MathJax todos já
% existem (ams, color, cancel), então não há nada a copiar desta parte.
\RequirePackage{amsmath}		% \boldsymbol, \operatorname, \iiint, \lvert, ...
\RequirePackage{amssymb}		% \varnothing, \leqslant, \mathbb, ... (carrega o amsfonts)
\RequirePackage{mathrsfs}		% \mathscr
\RequirePackage{xcolor}			% \textcolor, \definecolor
\RequirePackage{cancel}			% \cancelto, usado no \zer


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%  Início do bloco MathJax  %%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%     Comandos para modo Matemático     %%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\mt}[1]{{\:\mbox{#1}}\:}	% Texto no modo math

% \pm redefinido: "mais ou menos" em que o + não encosta no - (como no \pm
% original): o - é a linha do \underline, um pouco abaixo do +, e o \vcenter
% centraliza o conjunto na altura do + e do - à volta. Esta forma do \vcenter
% é a do MathJax; o fol-LaTeX.sty a redefine para o LaTeX.
% \Pm é sinônimo, para textos antigos.
\renewcommand{\pm}{\mathbin{\vcenter{\mkern1mu\underline{\mkern-1mu+\mkern-1mu}\mkern1mu}}}
\newcommand{\Pm}{\pm}

%%%%%%% Forçar \displaystyle dentro do \frac
 % By Mico at https://tex.stackexchange.com/questions/173899/fractions-with-large-elements
\newcommand{\ddfrac}[2]{\frac{\displaystyle #1}{\displaystyle #2}}
\newcommand{\ffrac}[2]{\frac{\displaystyle #1}{\displaystyle #2}}	% Igual ao \ddfrac


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%        Funções    %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\md}[1]{\mathop{\overline{\!#1}\,}\nolimits}	% Média

\newcommand{\sen}{\operatorname{sen}}		% Função Seno
\newcommand{\tg}{\operatorname{tg}}			% Função Tangente
\newcommand{\s}{\sen}						% Versão curta para seno
\newcommand{\q}{\cos}						% Versão curta para cosseno
\newcommand{\senh}{\operatorname{senh}}		% Função seno hiperbólico
\newcommand{\cotg}{\operatorname{cotg}}		% Função cotangente
\newcommand{\arctg}{\operatorname{arc\,tg}}	% Função arco tangente
\newcommand{\arcsen}{\operatorname{arc\,sen}}	% Função arco seno

\newcommand{\ee}{\operatorname{e}}		% Função exponencial
\newcommand{\ii}{\mathbf{i}}			% Número imaginário, sem o itálico do modo math


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% Setas %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\Lo}{\longrightarrow}		% Seta para direita longa (usado em def. funções)
\newcommand{\sss}{\Leftrightarrow}		% Seta de se e somente se (ou equivalente)
\newcommand{\SSS}{\Longleftrightarrow}	% Seta Longa de se e somente se (ou equivalente)
\newcommand{\imp}{\ \Rightarrow\ \ }	% Seta de se ... então (ou implica em)
\newcommand{\Imp}{\quad\Rightarrow\quad}	% Seta de Implicação com espaços


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%% Conjuntos %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\vazio}{\varnothing}		% Conjunto Vazio (mais bacana e mais usual)
\newcommand{\menosconj}{\smallsetminus}	% Menos para conjuntos (mais bacana)
% \leq e \geq (e os sinônimos \le e \ge) redefinidos com o traço inclinado.
% \Leq e \Geq são sinônimos, para textos antigos.
\renewcommand{\leq}{\leqslant}			% Menor ou Igual (mais bacana)
\renewcommand{\geq}{\geqslant}			% Maior ou Igual (mais bacana)
\renewcommand{\le}{\leqslant}
\renewcommand{\ge}{\geqslant}
\newcommand{\Leq}{\leq}
\newcommand{\Geq}{\geq}

\newcommand{\scC}{\mathscr{C}}	% script - C - Conjunto das Funções Contínuas
\renewcommand{\L}{\mathcal{L}}	% Call   - L - Transformada de Laplace
\newcommand{\bbC}{\mathbb{C}}	% Duplo  - C - Numeros Complexos
\newcommand{\bbR}{\mathbb{R}}	% Duplo  - R - Numeros Reais
\newcommand{\bbZ}{\mathbb{Z}}	% Duplo  - Z - Numeros Inteiros
\newcommand{\bbN}{\mathbb{N}}	% Duplo  - N - Numeros Naturais

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%   Cores em modo matemático   %%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Os nomes do xcolor e do CSS (usado pelo MathJax) nem sempre dão a mesma
% cor. Estas definições repetem os valores do xcolor, para que o MathJax
% mostre as mesmas cores do PDF (no LaTeX não mudam nada).
\definecolor{brown}{rgb}{0.75,0.5,0.25}
\definecolor{orange}{rgb}{1,0.5,0}
\definecolor{purple}{rgb}{0.75,0,0.25}
\definecolor{violet}{rgb}{0.5,0,0.5}
\definecolor{lightgray}{rgb}{0.75,0.75,0.75}

\newcommand{\red}[1]{{\textcolor{red}{#1}}}           % Vermelho
\newcommand{\blue}[1]{{\textcolor{blue}{#1}}}         % Azul
\newcommand{\cyan}[1]{{\textcolor{cyan}{#1}}}         % Azul claro
\newcommand{\green}[1]{{\textcolor{teal}{#1}}}        % Verde azulado
\newcommand{\olive}[1]{{\textcolor{olive}{#1}}}       % Verde escuro
\newcommand{\orange}[1]{{\textcolor{orange}{#1}}}     % Laranja
\newcommand{\magenta}[1]{{\textcolor{magenta}{#1}}}   % vermelho-rosado
\newcommand{\brown}[1]{{\textcolor{brown}{#1}}}       % Marron
\newcommand{\gray}[1]{{\textcolor{gray}{#1}}}         % Cinza
\newcommand{\lgray}[1]{{\textcolor{lightgray}{#1}}}   % Cinza claro
\newcommand{\purple}[1]{{\textcolor{purple}{#1}}}     % Roxo (parece vermelho escuro)
\newcommand{\violet}[1]{{\textcolor{violet}{#1}}}     % Violeta (parece roxo)


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%             Cálculo         %%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\dd}[1]{\frac{d}{d #1}}					% Derivada escalar
\newcommand{\pp}[1][x]{\frac{\partial}{\partial #1}}	% Derivada parcial (padrão: x)
\newcommand{\Int}{\int\limits}						% Integral com Domínio escrito abaixo
\newcommand{\II}{\iint\limits}						% Integral Dupla com Domínio escrito abaixo
\newcommand{\III}{\iiint\limits}					% Integral Tripla com Domínio escrito abaixo

% Seta vermelha cortando a expressão e apontando para o valor dela, por
% padrão 0. Ex.: \zer{\cos(2\theta)}   \zer[1]{\frac{x^2}{x^2}}
% A seta sobe da esquerda para a direita (é o \cancelto do pacote cancel).
% As versões antigas, em TikZ (seta descendo, cor e tamanho opcionais), são
% \Zer e \Zerup, no fol-LaTeX.sty.
\newcommand{\zer}[2][0]{\textcolor{red}{\cancelto{\scriptstyle #1}{\textcolor{black}{#2}}}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%     CÁLCULO VETORIAL    %%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Vetores Canônicos
\newcommand{\ci}{\boldsymbol{\stackrel{\rightarrow}{i}}}
\newcommand{\cj}{\boldsymbol{\stackrel{\rightarrow}{j}}}
\newcommand{\ck}{\boldsymbol{\stackrel{\rightarrow}{k}}}

\newcommand{\bbi}{\boldsymbol{\:i}}
\newcommand{\bbj}{\boldsymbol{\:j}}
\newcommand{\bbk}{\boldsymbol{\:k}}


% Vetor por extenso. Ex.: \lv{1, 2, 3}
\newcommand{\lv}[1]{\left\langle #1 \right\rangle}

\newcommand{\vt}[1]{\stackrel{\rightarrow}{#1}}						% Vetor
\newcommand{\Vt}[1]{\stackrel{\longrightarrow}{#1}}					% Vetor com seta maior, para segmentos.
\newcommand{\rt}[2][r]{\vt{#1}\!\!\!_{(#2)}}				% Função vetorial. Ex.: \rt{t} = r(t), \rt[F]{t} = F(t)
\newcommand{\esc}[2]{\vt{#1}\cdot\vt{#2}}							% Produto Interno ou Escalar
\newcommand{\vet}[2]{\,\vt{#1} \!\!\times\! \vt{#2}}				% Produto Vetorial
\newcommand{\abs}[1]{\left\lvert#1\right\rvert}						% Módulo do vetor
\newcommand{\curl}[1]{\nabla \times \vt{#1}}						% Rotacional
\newcommand{\dr}{\!\cdot \, d \! \stackrel{\rightarrow}{r}\,}		% Diferencial Vetorial de linha dr
\newcommand{\dvt}[1]{\, \cdot \, \stackrel{}{d} \stackrel{\rightarrow}{#1}}	% Diferencial Vetorial personalizável
\newcommand{\dS}{\cdot\stackrel{}{d} \stackrel{\rightarrow}{S}\,}	% Diferencial Vetorial de superfície dS


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%              Ambientes      %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Bloco de equações com Chave à esquerda
% Deve ser chamado dentro do modo matemático
% Opção padrão: até 9 colunas alinhadas à esquerda
\newenvironment{ea}[1][lllllllll]{\left\{\begin{array}{#1}}{\end{array}\right.}

\newcommand{\Det}[1]{\left|\begin{array}{cccccccc} #1 \end{array}\right|}
\newcommand{\Mat}[1]{\left(\begin{array}{cccccccc} #1 \end{array}\right)}
\newcommand{\Sis}[1]{\left\{\begin{array}{rrrrrrr} #1 \end{array}\right.}

