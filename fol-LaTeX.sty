% O \pm do fol-MathJax.sty, ajustado para o LaTeX: aqui o \vcenter precisa de
% um \hbox, e o \mathpalette passa o estilo atual para dentro dele, para que o
% símbolo encolha em frações pequenas e índices como o + e o - comuns.
\renewcommand{\pm}{\mathbin{\mathpalette\fol@Pm\relax}}
\newcommand{\fol@Pm}[2]{\vcenter{\hbox{$#1\mkern1mu\underline{\mkern-1mu+\mkern-1mu}\mkern1mu$}}}


